# Application Mode
DB_MODE=mock                    # 'mock' for local dev, 'oracle' for real DB

# Oracle Database Configuration
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USER=HOTEL_ADMIN
ORACLE_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8889

# Netlify
NODE_ENV=development

# SMTP (email notifications) — leave SMTP_HOST empty to log emails to console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp_user
# SMTP_PASS=smtp_password
# SMTP_FROM=no-reply@altonshotel.com

{
  "name": "altonshotel-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ALTONSHOTEL Management System — Netlify Functions Backend",
  "scripts": {
    "dev:api": "npx tsx dev-server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "echo 'Run these in separate terminals:' && echo '  Terminal 1: npm run dev:api' && echo '  Terminal 2: npm run dev:frontend'",
    "build:frontend": "cd frontend && npm run build",
    "start": "npx tsx dev-server.js"
  },
  "dependencies": {
    "@netlify/functions": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
